# LamaDB Configuration
# Copy this file to .env and fill in your values

# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://lamadb:lamadb_secret@postgres:5432/lamadb

# Random salt for hashing API keys (generate with: openssl rand -base64 32)
API_KEY_SALT=your-random-salt-here

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Uptime Kuma API (runs on valhalla)
UPTIME_KUMA_URL=http://valhalla:3001
UPTIME_KUMA_API_KEY=
UPTIME_KUMA_USER=
UPTIME_KUMA_PASSWORD=

# Hermes Agent API (runs on dev-vm)
HERMES_URL=http://dev-vm:9119
HERMES_API_KEY=
HERMES_DASHBOARD_SESSION_TOKEN=

# OpenAI API Key — deprecated: embeddings now use local sentence-transformers
# OPENAI_API_KEY=

# FreshRSS GReader API (runs on valhalla)
FRESHRSS_URL=http://valhalla:8780/api
FRESHRSS_USERNAME=
FRESHRSS_API_PASSWORD=

# Dozzle container log viewer (runs on probook)
DOZZLE_URL=http://probook:8080

# Home Assistant (accessible via Tailscale subnet routing through probook)
HA_URL=http://192.168.10.36:8123
HA_TOKEN=

# Notflix — Sonarr/Radarr/Tautulli media services
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
TAUTULLI_URL=
TAUTULLI_API_KEY=

# YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_WATCH_LATER_PLAYLIST_ID=
YOUTUBE_POLL_INTERVAL=3600

# Audiobookshelf — self-hosted audiobook + podcast server
AUDIOBOOKSHELF_URL=
AUDIOBOOKSHELF_TOKEN=
AUDIOBOOKSHELF_POLL_INTERVAL=1800
AUDIOBOOKSHELF_MAX_BOOKS_PER_LIBRARY=50

# Wiki — CouchDB LiveSync collector
WIKI_COUCHDB_URL=http://valhalla:5984
WIKI_COUCHDB_DB=obsidiannotes
WIKI_COUCHDB_USER=
WIKI_COUCHDB_PASSWORD=
WIKI_COUCHDB_ENCRYPTION_KEY=
